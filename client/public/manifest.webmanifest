{
  "id": "/",
  "name": "Premier Fantasy",
  "short_name": "PFantasy",
  "description": "Fantasy Football Manager de la Premier League: ficha jugadores reales, compite en ligas privadas y suma puntos cada jornada.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#060a12",
  "theme_color": "#060a12",
  "categories": ["sports", "games"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Alineación", "short_name": "Alineación", "url": "/lineup", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mercado", "short_name": "Mercado", "url": "/market", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ligas", "short_name": "Ligas", "url": "/leagues", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
