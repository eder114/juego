# Base de datos (SQLite en desarrollo). Para PostgreSQL: cambia provider en prisma/schema.prisma
DATABASE_URL="file:./dev.db"

PORT=4000
NODE_ENV=development
# URL pública del frontend (enlaces de recuperación de contraseña y CORS)
CLIENT_URL="http://localhost:5173"

# Genera un secreto largo y aleatorio en producción: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Administrador inicial creado por el seed
ADMIN_EMAIL="admin@premierfantasy.local"
ADMIN_PASSWORD="Admin12345!"

# Carpeta de datos de la temporada activa (generada con `npm run data:fetch`)
DATA_DIR="data/season-2026-27"

# SMTP opcional para recuperación de contraseña. Sin SMTP_HOST el enlace se imprime en consola.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Premier Fantasy <no-reply@premierfantasy.local>"
