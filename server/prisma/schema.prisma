// Premier Fantasy — modelo relacional
// Dinero: enteros en décimas de millón de libras (130 = £13.0M) para evitar errores de coma flotante.
// Enumeraciones: se guardan como String (SQLite) y se validan en la capa de servicios (src/domain/constants.ts).
// Para producción basta con cambiar el provider a "postgresql" y DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Usuarios ─────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  managerName    String
  role           String    @default("USER") // USER | ADMIN
  avatarUrl      String?
  favoriteClubId Int?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  favoriteClub    Club?                @relation(fields: [favoriteClubId], references: [id], onDelete: SetNull)
  team            FantasyTeam?
  ownedLeagues    League[]             @relation("LeagueOwner")
  memberships     LeagueMember[]
  notifications   Notification[]
  resetTokens     PasswordResetToken[]
  favorites       FavoritePlayer[]
  achievements    UserAchievement[]
  news            News[]
  avatar          UserAvatar?
  invitesSent     LeagueInvite[]       @relation("InviteSender")
  invitesReceived LeagueInvite[]       @relation("InviteReceiver")
  challengeAttempts DailyChallengeAttempt[]
  streaks           DailyStreak[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Competición ─────────────────────────────

model Club {
  id             Int      @id @default(autoincrement())
  externalId     Int?     @unique // id en la fuente externa (FPL)
  code           Int?     @unique // código oficial usado en escudos
  name           String   @unique
  shortName      String   @unique // ARS, LIV...
  commonName     String? // "Spurs", "Man City"
  city           String
  stadium        String
  primaryColor   String
  secondaryColor String
  crestUrl       String?
  isActive       Boolean  @default(true) // false = descendido / fuera de la temporada activa
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  players      Player[]
  homeFixtures Fixture[]         @relation("HomeClub")
  awayFixtures Fixture[]         @relation("AwayClub")
  fans         User[]
  statistics   PlayerStatistic[]
  news         News[]
  coaches      Coach[]

  @@map("clubs")
}

model Player {
  id              Int       @id @default(autoincrement())
  externalId      Int?      @unique
  code            Int?      @unique // código de foto oficial
  firstName       String
  lastName        String
  displayName     String
  position        String // GK | DEF | MID | FWD
  clubId          Int
  birthDate       DateTime?
  nationality     String?
  photoUrl        String?
  squadNumber     Int?
  price           Int // décimas de millón
  status          String    @default("AVAILABLE") // AVAILABLE | DOUBTFUL | INJURED | SUSPENDED | UNAVAILABLE
  chanceOfPlaying Int?
  news            String?
  isActive        Boolean   @default(true)
  // Economía de liga (v2): valor de mercado en miles de £ (100000 = £100M) y rareza calculada
  marketValue     Int?
  rarity          String    @default("COMMON") // COMMON | UNCOMMON | RARE | EPIC | STAR
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  club          Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)
  valuations    PlayerValuation[]
  ownerships    LeaguePlayerOwnership[]
  listings      MarketListing[]
  prices        PlayerPrice[]
  statistics    PlayerStatistic[]
  injuries      PlayerInjury[]
  squadEntries  FantasyTeamPlayer[]
  lineupEntries LineupPlayer[]
  transfers     Transfer[]
  favorites     FavoritePlayer[]
  newsItems     News[]

  @@index([clubId])
  @@index([position])
  @@index([displayName])
  @@map("players")
}

model PlayerPrice {
  id          Int      @id @default(autoincrement())
  playerId    Int
  gameweekId  Int?
  price       Int
  change      Int      @default(0)
  reason      String // INITIAL | PERFORMANCE | DEMAND | ADMIN | IMPORT | SYNC
  createdAt   DateTime @default(now())

  player   Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  gameweek Gameweek? @relation(fields: [gameweekId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt])
  @@map("player_prices")
}

model PlayerInjury {
  id             Int       @id @default(autoincrement())
  playerId       Int
  type           String // INJURY | SUSPENSION | ILLNESS | OTHER
  description    String
  startDate      DateTime  @default(now())
  expectedReturn DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, isActive])
  @@map("player_injuries")
}

model Gameweek {
  id            Int      @id // = número de jornada
  season        String
  name          String
  deadline      DateTime // cierre de alineaciones (modo DEADLINE) / referencia de recordatorios
  startsAt      DateTime?
  endsAt        DateTime?
  status        String   @default("UPCOMING") // UPCOMING | LIVE | FINISHED
  isProcessed   Boolean  @default(false) // puntuación definitiva calculada
  pricesUpdated Boolean  @default(false)
  valuationsUpdated Boolean @default(false) // valores de la economía de liga actualizados
  reminderSent  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fixtures   Fixture[]
  lineups    Lineup[]
  statistics PlayerStatistic[]
  prices     PlayerPrice[]
  transfers  Transfer[]

  @@map("gameweeks")
}

model Fixture {
  id             Int       @id @default(autoincrement())
  externalId     Int?      @unique
  gameweekId     Int
  homeClubId     Int
  awayClubId     Int
  kickoff        DateTime?
  status         String    @default("SCHEDULED") // SCHEDULED | LIVE | FINISHED | POSTPONED
  homeScore      Int?
  awayScore      Int?
  minute         Int       @default(0)
  homeDifficulty Int?
  awayDifficulty Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  gameweek   Gameweek          @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  homeClub   Club              @relation("HomeClub", fields: [homeClubId], references: [id], onDelete: Restrict)
  awayClub   Club              @relation("AwayClub", fields: [awayClubId], references: [id], onDelete: Restrict)
  statistics PlayerStatistic[]

  @@index([gameweekId])
  @@index([kickoff])
  @@map("fixtures")
}

model PlayerStatistic {
  id             Int      @id @default(autoincrement())
  playerId       Int
  fixtureId      Int
  gameweekId     Int // desnormalizado para consultas por jornada
  clubId         Int // club del jugador en ese partido (el jugador puede cambiar de club)
  minutes        Int      @default(0)
  goals          Int      @default(0)
  assists        Int      @default(0)
  cleanSheet     Boolean  @default(false)
  goalsConceded  Int      @default(0)
  ownGoals       Int      @default(0)
  penaltiesSaved Int      @default(0)
  penaltiesMissed Int     @default(0)
  yellowCards    Int      @default(0)
  redCards       Int      @default(0)
  saves          Int      @default(0)
  bonus          Int      @default(0)
  points         Int      @default(0)
  breakdown      String   @default("[]") // JSON [{action,label,value,points}]
  updatedAt      DateTime @updatedAt

  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fixture  Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  gameweek Gameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([playerId, fixtureId])
  @@index([gameweekId])
  @@map("player_statistics")
}

// ───────────────────────────── Juego ─────────────────────────────

model FantasyTeam {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  name        String
  crest       String   @default("{}") // JSON: {shape, primary, secondary, pattern, initials}
  budget      Int // sistema clásico: décimas de millón
  totalPoints Int      @default(0)
  // Economía: 1 = clásica (mercado libre global), 2 = economía de liga (mercado compartido)
  economyVersion  Int  @default(1)
  economyLeagueId Int? // liga cuya economía juega el equipo (una "partida")
  wallet          Int  @default(0) // economía de liga: miles de £
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  economyLeague League?            @relation("EconomyLeague", fields: [economyLeagueId], references: [id], onDelete: SetNull)
  players      FantasyTeamPlayer[]
  lineups      Lineup[]
  transfers    Transfer[]
  transactions Transaction[]
  playerOwnerships LeaguePlayerOwnership[]
  coachOwnerships  LeagueCoachOwnership[]
  cards            TeamCard[]
  cardActivations  CardActivation[] @relation("CardOwnerTeam")
  cardsReceived    CardActivation[] @relation("CardTargetTeam")

  @@index([economyLeagueId])

  @@map("fantasy_teams")
}

model FantasyTeamPlayer {
  id            Int      @id @default(autoincrement())
  teamId        Int
  playerId      Int
  purchasePrice Int
  acquiredAt    DateTime @default(now())

  team   FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([teamId, playerId])
  @@index([playerId])
  @@map("fantasy_team_players")
}

model Lineup {
  id            Int      @id @default(autoincrement())
  teamId        Int
  gameweekId    Int
  formation     String // "4-4-2"
  captainId     Int?
  viceCaptainId Int?
  points        Int      @default(0)
  benchPoints   Int      @default(0)
  isFinal       Boolean  @default(false)
  coachId       Int? // entrenador que puntúa en esta jornada (congelado al empezar la jornada)
  coachPoints   Int      @default(0)
  cardPoints    Int      @default(0) // efecto neto de las cartas sobre el total
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team     FantasyTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gameweek Gameweek       @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  coach    Coach?         @relation(fields: [coachId], references: [id], onDelete: SetNull)
  players  LineupPlayer[]

  @@unique([teamId, gameweekId])
  @@index([gameweekId])
  @@map("lineups")
}

model LineupPlayer {
  id            Int     @id @default(autoincrement())
  lineupId      Int
  playerId      Int
  role          String // STARTER | BENCH
  order         Int // titulares 0..10, suplentes 0..3 (prioridad)
  points        Int     @default(0) // puntos brutos del jugador en la jornada
  multiplier    Int     @default(1) // 0 = no suma, 1, 2 (capitán)
  autoSubIn     Boolean @default(false)
  autoSubOut    Boolean @default(false)
  cardDelta     Int     @default(0) // puntos añadidos/restados por cartas

  lineup Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([lineupId, playerId])
  @@map("lineup_players")
}

model Transfer {
  id         Int      @id @default(autoincrement())
  teamId     Int
  playerId   Int
  gameweekId Int?
  type       String // BUY | SELL
  price      Int
  createdAt  DateTime @default(now())

  team        FantasyTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Restrict)
  gameweek    Gameweek?    @relation(fields: [gameweekId], references: [id], onDelete: SetNull)
  transaction Transaction?

  @@index([teamId, createdAt])
  @@index([playerId, type])
  @@map("transfers")
}

model Transaction {
  id            Int      @id @default(autoincrement())
  teamId        Int
  transferId    Int?     @unique
  // Clásico: INITIAL_BUDGET | PURCHASE | SALE | ADJUSTMENT | REWARD
  // Economía de liga: INITIAL_BUDGET | PLAYER_PURCHASE | PLAYER_SALE | COACH_PURCHASE | COACH_SALE |
  //   DAILY_CHALLENGE_REWARD | STREAK_REWARD | CARD_REWARD | ADMIN_ADJUSTMENT | ECONOMY_RESET | OTHER_REWARD
  type          String
  amount        Int // con signo
  balanceAfter  Int
  description   String
  currency      String   @default("TENTHS") // TENTHS = décimas de millón (clásico) · K = miles de £ (economía de liga)
  balanceBefore Int?
  userId        String?
  leagueId      Int?
  reference     String? // entidad relacionada, p. ej. "listing:12", "challenge-attempt:5"
  operationId   String? // clave de idempotencia (su unicidad la garantiza economy_operation_keys)
  createdAt     DateTime @default(now())

  team     FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  transfer Transfer?   @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([operationId])
  @@map("transactions")
}

model League {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  code          String   @unique
  passwordHash  String?
  type          String // GLOBAL | PUBLIC | PRIVATE | FRIENDS | INVITE
  maxMembers    Int      @default(20)
  startGameweek Int      @default(1)
  ownerId       String?
  isSystem      Boolean  @default(false)
  // Economía de liga (v2)
  economyVersion    Int       @default(1)
  marketTimezone    String    @default("Europe/London")
  marketResetMinute Int? // minutos desde medianoche en marketTimezone; null = hora de creación de la liga
  marketPityCounter Int       @default(0) // ciclos seguidos sin jugadores de rareza alta
  economyStartedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner   User?          @relation("LeagueOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members LeagueMember[]
  invites LeagueInvite[]
  economyTeams     FantasyTeam[]           @relation("EconomyLeague")
  marketCycles     MarketCycle[]
  playerOwnerships LeaguePlayerOwnership[]
  coachOwnerships  LeagueCoachOwnership[]
  cooldowns        LeagueAssetCooldown[]

  @@index([type])
  @@map("leagues")
}

model LeagueMember {
  id       Int      @id @default(autoincrement())
  leagueId Int
  userId   String
  role     String   @default("MEMBER") // ADMIN | MEMBER
  joinedAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
  @@map("league_members")
}

model LeagueInvite {
  id         Int      @id @default(autoincrement())
  leagueId   Int
  senderId   String
  receiverId String
  status     String   @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt  DateTime @default(now())

  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  sender   User   @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User   @relation("InviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([leagueId, receiverId])
  @@map("league_invites")
}

// ───────────────────────────── Configuración ─────────────────────────────

model ScoringRule {
  id        Int      @id @default(autoincrement())
  position  String // GK | DEF | MID | FWD
  action    String // ver SCORING_ACTIONS
  points    Int
  threshold Int      @default(1) // unidades por bloque (p.ej. 3 paradas = 1 bloque) o minutos mínimos
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([position, action])
  @@map("scoring_rules")
}

model Setting {
  key         String   @id
  value       String // JSON
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  summary   String
  content   String
  category  String   @default("GENERAL") // GENERAL | INJURY | TRANSFER | GAMEWEEK | MARKET
  imageUrl  String?
  clubId    Int?
  playerId  Int?
  authorId  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club   Club?   @relation(fields: [clubId], references: [id], onDelete: SetNull)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)
  author User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("news")
}

model FavoritePlayer {
  userId    String
  playerId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([userId, playerId])
  @@map("favorite_players")
}

model UserAchievement {
  id         Int      @id @default(autoincrement())
  userId     String
  code       String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@map("user_achievements")
}

// Foto de perfil guardada en la BD: los hostings gratuitos no conservan archivos subidos al disco
model UserAvatar {
  userId    String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

// ───────────────────────────── Economía de liga (v2) ─────────────────────────────
// Dinero en miles de £ (k£): 100000 = £100M. Todo movimiento queda en `transactions` con currency = "K".

// Entrenadores reales (API oficial de la Premier League: cuerpo técnico de cada club)
model Coach {
  id          Int       @id @default(autoincrement())
  externalId  Int?      @unique // officialId en la API oficial
  optaId      String?   @unique // p. ej. "man51018" (foto oficial)
  firstName   String
  lastName    String
  displayName String
  clubId      Int?
  nationality String?
  birthDate   DateTime?
  photoUrl    String?
  marketValue Int       @default(0) // k£
  rarity      String    @default("COMMON")
  isActive    Boolean   @default(true) // false = ya no dirige un club de la temporada activa
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  club       Club?                  @relation(fields: [clubId], references: [id], onDelete: SetNull)
  valuations CoachValuation[]
  ownerships LeagueCoachOwnership[]
  listings   MarketListing[]
  lineups    Lineup[]

  @@index([clubId])
  @@map("coaches")
}

model PlayerValuation {
  id            Int      @id @default(autoincrement())
  playerId      Int
  gameweekId    Int?
  value         Int // k£
  previousValue Int?
  change        Int      @default(0)
  variationBp   Int      @default(0) // variación en puntos básicos (100 = 1 %)
  reason        String // INITIAL | PERFORMANCE | ADMIN | RECALIBRATION
  factors       String   @default("{}") // JSON con los factores usados por la fórmula
  createdAt     DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, gameweekId, reason])
  @@index([playerId, createdAt])
  @@map("player_valuations")
}

model CoachValuation {
  id            Int      @id @default(autoincrement())
  coachId       Int
  gameweekId    Int?
  value         Int
  previousValue Int?
  change        Int      @default(0)
  variationBp   Int      @default(0)
  reason        String
  factors       String   @default("{}")
  createdAt     DateTime @default(now())

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, gameweekId, reason])
  @@index([coachId, createdAt])
  @@map("coach_valuations")
}

// Un mercado diario por liga: todos los miembros ven exactamente los mismos anuncios
model MarketCycle {
  id         Int      @id @default(autoincrement())
  leagueId   Int
  cycleDate  String // fecha local (YYYY-MM-DD) del inicio del ciclo en la zona horaria de la liga (informativa)
  startsAt   DateTime // UTC
  endsAt     DateTime // UTC
  pityBefore Int      @default(0)
  createdAt  DateTime @default(now())

  league   League          @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  listings MarketListing[]

  @@unique([leagueId, startsAt]) // dos generaciones simultáneas del mismo ciclo: solo una prospera
  @@index([leagueId, cycleDate])
  @@map("market_cycles")
}

model MarketListing {
  id           Int       @id @default(autoincrement())
  cycleId      Int
  leagueId     Int
  assetType    String // PLAYER | COACH
  playerId     Int?
  coachId      Int?
  rarity       String
  listingPrice Int // k£: precio fijado al generar el mercado (no cambia durante el ciclo)
  slot         Int
  status       String    @default("AVAILABLE") // AVAILABLE | SOLD
  buyerTeamId  Int?
  soldAt       DateTime?
  createdAt    DateTime  @default(now())

  cycle  MarketCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  player Player?     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  coach  Coach?      @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([cycleId, playerId])
  @@unique([cycleId, coachId])
  @@index([leagueId, status])
  @@map("market_listings")
}

// Propiedad por liga: un jugador solo puede pertenecer a un equipo dentro de la misma liga
model LeaguePlayerOwnership {
  id            Int      @id @default(autoincrement())
  leagueId      Int
  playerId      Int
  teamId        Int
  purchasePrice Int // k£
  source        String // STARTER | MARKET
  acquiredAt    DateTime @default(now())

  league League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([leagueId, playerId])
  @@unique([teamId, playerId])
  @@map("league_player_ownerships")
}

model LeagueCoachOwnership {
  id            Int      @id @default(autoincrement())
  leagueId      Int
  coachId       Int
  teamId        Int
  purchasePrice Int
  acquiredAt    DateTime @default(now())

  league League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  coach  Coach       @relation(fields: [coachId], references: [id], onDelete: Cascade)
  team   FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([leagueId, coachId])
  @@index([teamId])
  @@map("league_coach_ownerships")
}

// Tras una venta, el jugador/entrenador no vuelve al mercado de esa liga hasta `availableAt`
model LeagueAssetCooldown {
  id          Int      @id @default(autoincrement())
  leagueId    Int
  assetType   String // PLAYER | COACH
  assetId     Int
  availableAt DateTime

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, assetType, assetId])
  @@map("league_asset_cooldowns")
}

// Idempotencia de las operaciones económicas: una misma operación (compra de un anuncio, premio de un
// desafío…) solo puede registrarse una vez. Tabla propia para no añadir restricciones únicas a `transactions`.
model EconomyOperationKey {
  key       String   @id
  createdAt DateTime @default(now())

  @@map("economy_operation_keys")
}

// Registro de auditoría del mercado (se conserva aunque se borre la liga)
model MarketAuditLog {
  id        Int      @id @default(autoincrement())
  leagueId  Int?
  cycleId   Int?
  teamId    Int?
  userId    String?
  action    String // CYCLE_GENERATED | PURCHASE | PURCHASE_REJECTED | SALE | ECONOMY_JOINED | ECONOMY_LEFT | ECONOMY_RESET | LEAGUE_MIGRATED
  details   String   @default("{}")
  createdAt DateTime @default(now())

  @@index([leagueId, createdAt])
  @@index([teamId, createdAt])
  @@map("market_audit_logs")
}

// ───────────────────────────── Cartas potenciadoras ─────────────────────────────

model PowerUpCard {
  id                Int      @id @default(autoincrement())
  code              String   @unique
  name              String
  description       String
  effect            String // DOUBLE_POINTS | WEAKEN (ampliable)
  rarity            String // COMMON | RARE | EPIC | LEGENDARY
  effectValue       Int // DOUBLE_POINTS: multiplicador en % (200 = x2) · WEAKEN: % de puntos que se restan
  target            String // OWN_PLAYER | RIVAL_PLAYER
  durationGameweeks Int      @default(1)
  maxPerGameweek    Int      @default(1) // cuántas cartas de este efecto puede activar un equipo por jornada
  isActive          Boolean  @default(true) // se puede activar
  obtainable        Boolean  @default(true) // se puede conseguir como recompensa
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inventory   TeamCard[]
  activations CardActivation[]

  @@map("powerup_cards")
}

// Inventario: cada fila es una carta de un solo uso
model TeamCard {
  id         Int       @id @default(autoincrement())
  teamId     Int
  cardId     Int
  status     String    @default("AVAILABLE") // AVAILABLE | ACTIVE | USED
  source     String // STREAK | CHALLENGE | ACHIEVEMENT | EVENT | ADMIN
  sourceRef  String?   @unique // idempotencia de la concesión (p. ej. "streak:<user>:<fecha>:7")
  acquiredAt DateTime  @default(now())
  usedAt     DateTime?

  team        FantasyTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  card        PowerUpCard      @relation(fields: [cardId], references: [id], onDelete: Restrict)
  activations CardActivation[]

  @@index([teamId, status])
  @@map("team_cards")
}

model CardActivation {
  id             Int       @id @default(autoincrement())
  teamCardId     Int
  teamId         Int
  cardId         Int
  gameweekId     Int
  effect         String
  effectValue    Int // copia del valor al activar: cambios posteriores del catálogo no afectan
  targetPlayerId Int
  targetTeamId   Int
  status         String    @default("ACTIVE") // ACTIVE | CANCELLED | APPLIED
  requestId      String    @unique // idempotencia frente a dobles envíos
  pointsDelta    Int       @default(0)
  createdAt      DateTime  @default(now())
  cancelledAt    DateTime?
  appliedAt      DateTime?

  teamCard   TeamCard    @relation(fields: [teamCardId], references: [id], onDelete: Cascade)
  card       PowerUpCard @relation(fields: [cardId], references: [id], onDelete: Restrict)
  team       FantasyTeam @relation("CardOwnerTeam", fields: [teamId], references: [id], onDelete: Cascade)
  targetTeam FantasyTeam @relation("CardTargetTeam", fields: [targetTeamId], references: [id], onDelete: Cascade)

  @@index([gameweekId, status])
  @@index([teamId, gameweekId])
  @@index([targetTeamId, gameweekId])
  @@map("card_activations")
}

model CardUsageLog {
  id         Int      @id @default(autoincrement())
  teamId     Int
  teamCardId Int?
  action     String // GRANTED | ACTIVATED | CANCELLED | APPLIED | REJECTED
  details    String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([teamId, createdAt])
  @@map("card_usage_logs")
}

// ───────────────────────────── Desafíos diarios ─────────────────────────────

model DailyChallenge {
  id            Int      @id @default(autoincrement())
  type          String // WORDLE (ampliable: PLAYER_TRIVIA, GUESS_THE_PLAYER…)
  challengeDate String // YYYY-MM-DD en la zona horaria de los desafíos
  timezone      String
  secret        String // JSON solo servidor (p. ej. la palabra). Nunca se envía antes de terminar.
  meta          String   @default("{}")
  createdAt     DateTime @default(now())

  attempts DailyChallengeAttempt[]

  @@unique([type, challengeDate])
  @@map("daily_challenges")
}

model DailyChallengeAttempt {
  id            Int       @id @default(autoincrement())
  challengeId   Int
  userId        String
  type          String
  challengeDate String
  attemptsUsed  Int       @default(0)
  maxAttempts   Int
  guesses       String    @default("[]") // JSON [{word, result:[...]}] evaluado por el servidor
  completed     Boolean   @default(false)
  won           Boolean   @default(false)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  challenge DailyChallenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward    DailyChallengeReward?

  @@unique([userId, challengeDate, type])
  @@map("daily_challenge_attempts")
}

model DailyChallengeReward {
  id          Int      @id @default(autoincrement())
  attemptId   Int      @unique // una sola recompensa por desafío
  userId      String
  teamId      Int?
  amount      Int // en la moneda indicada
  currency    String // K | TENTHS
  streakBonus Int      @default(0)
  streakDays  Int      @default(0)
  cardCode    String?
  createdAt   DateTime @default(now())

  attempt DailyChallengeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("daily_challenge_rewards")
}

model DailyStreak {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String // DAILY_CHALLENGE
  current   Int      @default(0)
  best      Int      @default(0)
  lastDate  String? // última fecha que cuenta para la racha
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("daily_streaks")
}
